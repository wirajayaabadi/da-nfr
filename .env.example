# Salin berkas ini menjadi .env.local. .env.local tidak ikut di-commit.
# Login dasbor memakai akun Bright Match, jadi isinya sama dengan ../bright-match/.env.local.

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API Keys > Publishable key (sb_publishable_…).
# Jangan pernah menaruh secret key atau service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
